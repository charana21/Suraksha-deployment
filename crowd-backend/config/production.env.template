# =============================================================================
# CROWDVISION PRODUCTION CONFIGURATION TEMPLATE
# =============================================================================
#
# Copy this file to production.env and modify for your deployment:
#   cp production.env.template production.env
#
# All values shown are defaults. Uncomment and modify as needed.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------

# Environment mode: development, production
APP_ENV=production

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (leave empty for console-only logging)
LOG_FILE=/var/log/crowdvision/app.log

# Log rotation settings
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# -----------------------------------------------------------------------------
# API SERVER SETTINGS
# -----------------------------------------------------------------------------

# Host and port for the API server
API_HOST=0.0.0.0
API_PORT=8000

# Number of workers (1 recommended for GPU workloads)
API_WORKERS=1

# -----------------------------------------------------------------------------
# GPU / PROCESSING SETTINGS
# -----------------------------------------------------------------------------

# Device: cuda (GPU) or cpu
DEVICE=cuda

# Enable GPU acceleration
USE_GPU=true

# Share models across streams (recommended: true for multi-stream deployments)
USE_SHARED_MODEL_POOL=true

# Enable batched inference (recommended: true for 5+ cameras)
# This batches frames from multiple cameras for parallel GPU processing
# Works WITH SharedModelPool - both should be true for production
USE_BATCHED_INFERENCE=true

# -----------------------------------------------------------------------------
# BATCHED INFERENCE TUNING (for 10-20+ cameras)
# -----------------------------------------------------------------------------

# Max frames per batch (higher = better GPU utilization, more memory)
BATCH_YOLO_SIZE=40

# Max wait time to accumulate batch (ms)
BATCH_TIMEOUT_MS=150.0

# Queue size and fairness limits
INFERENCE_QUEUE_SIZE=160
INFERENCE_PER_CAMERA_LIMIT=4

# PET inference interval: run PET every Nth frame, YOLO-only for rest
PET_INFERENCE_INTERVAL=5

# Timeout for inference result (ms) - CPU needs 120s+, GPU can use 10s
INFERENCE_TIMEOUT_MS=120000.0

# -----------------------------------------------------------------------------
# MODEL PATHS
# -----------------------------------------------------------------------------

# YOLO model for object detection
YOLO_MODEL_PATH=/opt/crowdvision/weights/yolov8n.pt

# Density estimation model (production PET-only)
DENSITY_MODEL=pet

# PET model checkpoint and inference thresholds
PET_WEIGHTS_PATH=/opt/crowdvision/weights/SHA_model.pth
PET_CONF_THRESHOLD=0.5
PET_NMS_DISTANCE=6.0
PET_MAX_HEIGHT_SPARSE=1280
PET_MAX_HEIGHT_MEDIUM=1024
PET_MAX_HEIGHT_HIGH=896
PET_MAX_HEIGHT_DEFAULT=1024
PET_USE_ADAPTIVE_FUSION=true

# Gaussian smoothing for density map visualization
DENSITY_GAUSSIAN_SIGMA=15.0

# -----------------------------------------------------------------------------
# REGIME-BASED FUSION CONFIGURATION
# -----------------------------------------------------------------------------
# Density regime thresholds (based on max of YOLO/PET count)
DENSITY_REGIME_SPARSE_MAX=15
DENSITY_REGIME_LOW_MAX=50
DENSITY_REGIME_MEDIUM_MAX=120

# YOLO occupancy thresholds (fraction of frame covered by bboxes)
YOLO_OCCUPANCY_LOW_MAX=0.05
YOLO_OCCUPANCY_MEDIUM_MAX=0.15
YOLO_OCCUPANCY_HIGH_MAX=0.30

# Fusion weights by regime (PET weight; YOLO weight = 1 - this)
FUSION_WEIGHT_SPARSE=0.75
FUSION_WEIGHT_LOW=0.80
FUSION_WEIGHT_MEDIUM=0.85
FUSION_WEIGHT_HIGH=0.95

# PET dense-scene fusion guard
FUSION_PET_GUARD_ENABLED=true
FUSION_PET_GUARD_MIN_COUNT=220
FUSION_PET_GUARD_MIN_OCCUPANCY=0.18
FUSION_PET_GUARD_SKIP_CALIBRATION=true

# -----------------------------------------------------------------------------
# MONGODB SETTINGS
# -----------------------------------------------------------------------------

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017

# Database name
MONGODB_DATABASE=crowdvision

# Connection pool size
MONGODB_MAX_POOL_SIZE=100

# -----------------------------------------------------------------------------
# RTSP STREAM SETTINGS
# -----------------------------------------------------------------------------

# Frames per second to process (1 FPS recommended for analytics)
RTSP_DEFAULT_FPS=1

# Reconnection attempts on stream failure
RTSP_RECONNECT_ATTEMPTS=10

# Delay between reconnection attempts (seconds)
RTSP_RECONNECT_DELAY=5.0

# -----------------------------------------------------------------------------
# RISK DETECTION SETTINGS (Railway Station Optimized)
# -----------------------------------------------------------------------------

# Enable railway station mode (optimized thresholds)
RAILWAY_STATION_MODE=true

# Compression detection threshold (negative divergence)
# More negative = require stronger convergence signal
COMPRESSION_THRESHOLD=-4.0

# Baseline crowd density for red zone detection
BASELINE_CROWD_DENSITY=0.6

# Red zone threshold multiplier
RED_ZONE_THRESHOLD_MULTIPLIER=1.5

# Minimum people count before red zone triggers
MIN_PEOPLE_FOR_RED_ZONE=30

# -----------------------------------------------------------------------------
# ALERT SETTINGS
# -----------------------------------------------------------------------------

# Minimum time between alerts per camera (seconds)
ALERT_COOLDOWN_SECONDS=30.0

# Risk levels that trigger image capture
ALERT_IMAGE_RISK_LEVELS=["HIGH", "CRITICAL"]

# -----------------------------------------------------------------------------
# DATA RETENTION (days)
# -----------------------------------------------------------------------------

# Analytics data retention
ANALYTICS_RETENTION_DAYS=30

# Alert history retention
ALERTS_RETENTION_DAYS=90

# Captured images retention
IMAGES_RETENTION_DAYS=90

# Raw detections (debugging only)
DETECTIONS_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# STORAGE PATHS
# -----------------------------------------------------------------------------

# Base data directory
# Note: Create these directories and set proper permissions
UPLOAD_DIR=/opt/crowdvision/data/uploads
OUTPUT_DIR=/opt/crowdvision/data/outputs
HEATMAP_DIR=/opt/crowdvision/data/heatmaps
ANALYTICS_DIR=/opt/crowdvision/data/analytics
IMAGES_DIR=/opt/crowdvision/data/images

# -----------------------------------------------------------------------------
# HEATMAP SETTINGS
# -----------------------------------------------------------------------------

# Explicitly disable saving heatmaps to disk (performance/storage)
SAVE_HEATMAPS=false

# Maximum width for heatmap images (maintains aspect ratio)
HEATMAP_MAX_WIDTH=800

# JPEG quality for heatmaps (70-85 recommended)
HEATMAP_JPEG_QUALITY=75

# Image format: jpg or png (jpg is faster and smaller)
HEATMAP_FORMAT=jpg

# Show YOLO detection boxes on heatmaps (for testing/debugging)
SHOW_DETECTION_BOXES=true

# Enable async heatmap saving (non-blocking)
HEATMAP_ASYNC=true

# -----------------------------------------------------------------------------
# DEBUG SETTINGS (Disable in production!)
# -----------------------------------------------------------------------------

# Debug mode: process only one specific stream
DEBUG_SINGLE_STREAM=false
DEBUG_TARGET_STREAM=rtsp://localhost:8554/mystream
