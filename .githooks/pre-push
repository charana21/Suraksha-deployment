#!/usr/bin/env bash
# =============================================================================
# Suraksha Pre-Push Secret Guard Hook
# Restricts git push if critical secrets or sensitive files are detected
# =============================================================================
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
SCANNER="$REPO_ROOT/scripts/scan_secrets.py"

if [[ ! -f "$SCANNER" ]]; then
    echo "[WARN] Secret scanner script not found at $SCANNER. Skipping check." >&2
    exit 0
fi

# Pass standard input and arguments to python scanner
python3 "$SCANNER" --push "$@"
